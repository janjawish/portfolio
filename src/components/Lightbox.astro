---
/** Visionneuse d'images accessible (élément <dialog> natif). Cible les liens [data-lightbox="groupe"]. */
---

<dialog class="lightbox" data-lightbox-dialog aria-label="Visionneuse d’images">
  <figure class="lightbox__figure">
    <img class="lightbox__img" alt="" data-lightbox-img />
    <figcaption class="lightbox__caption" data-lightbox-caption></figcaption>
  </figure>
  <div class="lightbox__bar">
    <span class="lightbox__count" data-lightbox-count></span>
    <div class="lightbox__actions">
      <button type="button" class="lightbox__btn" data-lightbox-prev aria-label="Image précédente">←</button>
      <button type="button" class="lightbox__btn" data-lightbox-next aria-label="Image suivante">→</button>
      <button type="button" class="lightbox__btn" data-lightbox-close aria-label="Fermer la visionneuse">✕</button>
    </div>
  </div>
</dialog>

<script>
  // Visionneuse : initialisée à chaque page (navigation avec le ClientRouter d'Astro).
  let group: HTMLAnchorElement[] = [];
  let index = 0;
  const q = <T extends Element>(sel: string) => document.querySelector<T>(sel);

  function show(i: number) {
    const img = q<HTMLImageElement>('[data-lightbox-img]');
    if (!img || !group.length) return;
    index = (i + group.length) % group.length;
    const a = group[index];
    img.src = a.href;
    img.alt = a.dataset.alt ?? '';
    const caption = q<HTMLElement>('[data-lightbox-caption]');
    const count = q<HTMLElement>('[data-lightbox-count]');
    if (caption) caption.textContent = a.dataset.caption ?? '';
    if (count) count.textContent = `${index + 1} / ${group.length}`;
  }

  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-lightbox]');
    const dialog = q<HTMLDialogElement>('[data-lightbox-dialog]');
    if (!a || !dialog || e.metaKey || e.ctrlKey) return;
    e.preventDefault();
    group = Array.from(document.querySelectorAll<HTMLAnchorElement>(`a[data-lightbox="${a.dataset.lightbox}"]`));
    show(group.indexOf(a));
    dialog.showModal();
  });

  document.addEventListener('astro:page-load', () => {
    const dialog = q<HTMLDialogElement>('[data-lightbox-dialog]');
    if (!dialog || dialog.dataset.ready) return;
    dialog.dataset.ready = '1';
    q('[data-lightbox-prev]')?.addEventListener('click', () => show(index - 1));
    q('[data-lightbox-next]')?.addEventListener('click', () => show(index + 1));
    q('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  });
</script>

<style>
  .lightbox {
    width: min(96vw, 1400px);
    max-width: none;
    height: min(94vh, 1000px);
    max-height: none;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: rgba(11, 11, 12, 0.96);
    color: var(--paper);
    overflow: hidden;
  }
  .lightbox[open] {
    display: grid;
    grid-template-rows: 1fr auto;
  }
  .lightbox::backdrop {
    background: rgba(11, 11, 12, 0.8);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
  .lightbox__figure {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 8px;
    min-height: 0;
    padding: 20px 20px 0;
  }
  .lightbox__img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
  }
  .lightbox__caption {
    font-size: var(--fs-sm);
    color: var(--mist);
    text-align: center;
    min-height: 1.4em;
  }
  .lightbox__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
  }
  .lightbox__count {
    font-size: var(--fs-xs);
    color: var(--mist-2);
    font-variant-numeric: tabular-nums;
  }
  .lightbox__actions {
    display: flex;
    gap: 8px;
  }
  .lightbox__btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--paper);
    cursor: pointer;
  }
  .lightbox__btn:hover {
    background: rgba(245, 243, 238, 0.08);
  }
</style>

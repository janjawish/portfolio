---
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '@fontsource-variable/geist/wght.css';
import '@/styles/global.css';
import displayFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-standard-normal.woff2?url';
import bodyFont from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import Seo from '@/components/Seo.astro';
import Footer from '@/components/Footer.astro';
import SiteHeader from '@/components/islands/SiteHeader';
import Assistant from '@/components/islands/Assistant';
import { ClientRouter } from 'astro:transitions';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  jsonLd?: Record<string, unknown>[];
  tags?: string[];
  /** Masque le pied de page (ex. 404 plein écran). */
  bare?: boolean;
}

const { bare = false, ...seo } = Astro.props;
---

<!doctype html>
<html lang="fr" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0B0B0C" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Blog de Jan Jawish" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <Seo {...seo} />
    <script is:inline>
      (function () {
        // Niveau d'effets (voir src/lib/effects.ts) : mode allégé si l'appareil est modeste,
        // si « économiser les données » est actif, sans WebGL 2, ou si une visite précédente l'a décidé.
        var lite = false;
        try {
          var saved = JSON.parse(localStorage.getItem('jj-effects') || 'null');
          if (saved && saved.level === 'lite' && saved.until > Date.now()) lite = true;
        } catch (e) {}
        var conn = navigator.connection;
        var mem = navigator.deviceMemory;
        var cores = navigator.hardwareConcurrency;
        var coarse = matchMedia('(pointer: coarse)').matches;
        if (
          (conn && conn.saveData) ||
          !('WebGL2RenderingContext' in window) ||
          (mem && mem <= 2) ||
          (cores && cores <= 2) ||
          (coarse && cores && cores <= 4 && mem && mem <= 4)
        )
          lite = true;
        window.__jjLite = lite;
        // Classes de capacité sur <html>, réappliquées après chaque navigation (le routeur remplace les attributs de <html>).
        var mark = function () {
          var c = document.documentElement.classList;
          c.add('js');
          if ('WebGL2RenderingContext' in window) c.add('webgl2');
          if (window.__jjLite) c.add('lite');
        };
        mark();
        document.addEventListener('astro:after-swap', mark);
        // Clic droit désactivé (choix de Jan), sauf dans les champs de saisie (copier-coller dans le formulaire).
        document.addEventListener('contextmenu', function (e) {
          var t = e.target;
          if (t && t.closest && t.closest('input, textarea, [contenteditable="true"]')) return;
          e.preventDefault();
        });
        // Intro de l'accueil, à l'arrivée sur le site seulement : prisme, puis nom, puis le reste.
        // Le défilement est bloqué pendant l'intro (débloqué par HeroScene, ou au bout de 9 s au plus tard).
        var d = document.documentElement;
        var nav = performance.getEntriesByType ? performance.getEntriesByType('navigation')[0] : null;
        if (
          location.pathname === '/' &&
          !location.hash &&
          !lite &&
          !matchMedia('(prefers-reduced-motion: reduce)').matches &&
          !(nav && nav.type === 'back_forward')
        ) {
          d.classList.add('intro', 'scroll-lock');
          window.__introStart = performance.now();
          setTimeout(function () {
            if (!d.classList.contains('intro')) return;
            d.classList.remove('intro', 'scroll-lock');
            if (!d.classList.contains('hero-art-ready')) d.classList.add('hero-art-timeout');
            window.dispatchEvent(new Event('jj:intro-done'));
            var lenis = window['__lenis'];
            if (lenis) lenis.start();
          }, 9000);
        }
      })();
    </script>
    <ClientRouter fallback="none" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <SiteHeader client:load transition:persist="site-header" />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    {!bare && <Footer />}
    <Assistant client:idle transition:persist="assistant" />

    <script>
      // Défilement amorti : démarré une seule fois pour tout le site (le ClientRouter conserve ce module).
      import { demarrerDefilement, getLenis, remonter, defilerVers } from '@/lib/smoothScroll';
      import { startFpsProbe } from '@/lib/effects';
      demarrerDefilement();
      // Mesure de fluidité au premier affichage : bascule en mode allégé si l'appareil peine.
      startFpsProbe();
      let navType = 'push';
      document.addEventListener('astro:before-preparation', (e) => {
        navType = (e as Event & { navigationType?: string }).navigationType ?? 'push';
      });
      document.addEventListener('astro:after-swap', () => {
        // Nouvelle page : on repart du haut (le retour arrière garde la position restaurée par le navigateur).
        if (navType !== 'traverse' && !location.hash) remonter();
      });
      document.addEventListener('astro:page-load', () => getLenis()?.resize());
      // Liens d'ancre et sommaires : défilement amorti avec décalage de 96 px.
      document.addEventListener(
        'click',
        (e) => {
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          const a = (e.target as Element | null)?.closest?.('a[href]') as HTMLAnchorElement | null;
          if (!a) return;
          const url = new URL(a.href, location.href);
          if (!url.hash || url.pathname !== location.pathname || url.search !== location.search) return;
          const target = document.getElementById(decodeURIComponent(url.hash.slice(1)));
          if (!target) return;
          e.preventDefault();
          defilerVers(target);
          history.pushState(history.state, '', url.hash);
          if (target.tabIndex < 0 && !target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
          target.focus({ preventScroll: true });
        },
        true,
      );
    </script>
    <script>
      // Apparition progressive des éléments [data-reveal], sans dépendance (relancée à chaque page).
      let io: IntersectionObserver | null = null;
      const reveal = () => {
        io?.disconnect();
        const els = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-visible)');
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const obs = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                obs.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        io = obs;
        els.forEach((el) => obs.observe(el));
      };
      document.addEventListener('astro:page-load', reveal);
    </script>
  </body>
</html>

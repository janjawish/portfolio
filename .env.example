# Formulaire de contact
# URL d'un service d'envoi acceptant un POST JSON (ex. Web3Forms : https://api.web3forms.com/submit,
# ou Formspree : https://formspree.io/f/<id>). Laisser vide pour désactiver l'envoi direct :
# le formulaire propose alors honnêtement d'ouvrir la messagerie du visiteur (mailto).
PUBLIC_CONTACT_ENDPOINT=

# Clé publique Web3Forms (access_key), uniquement si PUBLIC_CONTACT_ENDPOINT pointe vers Web3Forms.
PUBLIC_CONTACT_ACCESS_KEY=

# Vérification des outils pour webmasters (facultatif : la vérification par DNS dans Vercel est préférable).
# Google Search Console : méthode « Balise HTML », copier seulement la valeur de content="…".
PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools : méthode « Balise meta » (msvalidate.01), ou import direct depuis Search Console.
PUBLIC_BING_SITE_VERIFICATION=
